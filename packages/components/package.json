{
  "name": "@mp-front/components",
  "version": "0.0.1-next-14",
  "private": false,
  "type": "module",
  "main": "./dist/ui-components-index.cjs",
  "module": "./dist/ui-components-index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b ./tsconfig.lib.json && vite build && npm run build:css",
    "build:css": "npx @tailwindcss/cli -m -i ./src/styles/globals.css -o ./dist/styles.css",
    "storybook": "storybook dev -p 80",
    "build-storybook": "storybook build",
    "push:npm": "np --branch feature/ui-components",
    "test": "vitest",
    "lint": "eslint . --fix",
    "sonar": "node sonar-project.js",
    "husky:prepare": "husky install",
    "package": "rm -f *.tgz && rm -r dist && npm run build && npm pack",
    "pull-dev": "git pull origin && npm run dev",
    "pull-book": "git pull origin && npm run storybook",
    "coverage": "vitest run --coverage",
    "build-docker-storybook": "storybook build && docker build -f Dockerfile.static -t storybook-static . && rm -rf storybook-static"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/ui-components-index.js",
      "require": "./dist/ui-components-index.cjs"
    },
    "./charts": {
      "types": "./dist/lib/components/charts/index.d.ts",
      "import": "./dist/ui-components-charts.js",
      "require": "./dist/ui-components-charts.cjs"
    },
    "./custom": {
      "types": "./dist/components/custom/index.d.ts",
      "import": "./dist/ui-components-custom.js",
      "require": "./dist/ui-components-custom.cjs"
    },
    "./animation": {
      "types": "./dist/components/animation/index.d.ts",
      "import": "./dist/ui-components-animation.js",
      "require": "./dist/ui-components-animation.cjs"
    },
    "./icons": {
      "types": "./dist/assets/icons/index.d.ts",
      "import": "./dist/ui-components-icons.js",
      "require": "./dist/ui-components-icons.cjs"
    },
    "./loadings": {
      "types": "./dist/components/loadings/index.d.ts",
      "import": "./dist/ui-components-loadings.js",
      "require": "./dist/ui-components-loadings.cjs"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/ui-components-layout.js",
      "require": "./dist/ui-components-layout.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/ui-components-hooks.js",
      "require": "./dist/ui-components-hooks.cjs"
    },
    "./types": {
      "types": "./dist/interfaces/index.d.ts"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/ui-components-utils.js",
      "require": "./dist/ui-components-utils.cjs"
    },
    "./styles.css": {
      "require": "./dist/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "peerDependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-number-format": "5.4.3",
    "react-select": "5.9.0",
    "rxjs": "7.8.1"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@glidejs/glide": "3.7.1",
    "@mp-front/icons": "0.0.2",
    "@tanstack/react-table": "8.20.6",
    "chart.js": "4.4.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3": "7.9.0",
    "dinero.js": "1.9.1",
    "embla-carousel-react": "8.6.0",
    "i18next": "25.8.10",
    "motion": "12.23.26",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.4.3",
    "rc-pagination": "5.0.0",
    "react-barcode": "1.6.1",
    "react-chartjs-2": "5.3.0",
    "react-i18next": "16.5.4",
    "react-number-format": "5.4.3",
    "rxjs": "7.8.1",
    "tailwind-merge": "2.6.0",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.2.17",
    "@storybook/addon-links": "10.2.17",
    "@storybook/addon-themes": "10.2.17",
    "@storybook/addon-vitest": "10.2.17",
    "@storybook/jest": "0.2.3",
    "@storybook/react-vite": "10.2.17",
    "@storybook/testing-library": "0.2.1",
    "@tailwindcss/postcss": "4.1.18",
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/react": "16.1.0",
    "@types/d3": "7.4.3",
    "@types/d3-scale-chromatic": "3.1.0",
    "@types/dinero.js": "1.9.4",
    "@types/glidejs__glide": "3.6.5",
    "@vitest/browser-playwright": "4.0.16",
    "@vitest/coverage-v8": "4.0.16",
    "playwright": "1.57.0",
    "storybook": "10.2.17",
    "jsdom": "27.4.0",
    "tailwindcss": "4.1.17",
    "eslint-plugin-storybook": "10.2.17"
  }
}